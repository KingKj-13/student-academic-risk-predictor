# The app reads ordinary environment variables; it does not load this file by itself.
# Set the ones you need in your terminal or in your hosting dashboard.

# Password protection (required for any public deployment)
APP_USERNAME=
APP_PASSWORD=
REQUIRE_AUTH=0

# Optional email alerts (leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
